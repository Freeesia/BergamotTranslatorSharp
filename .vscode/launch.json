{
    "version": "0.2.0",
    "configurations": [
        {
            // IntelliSense を使用して、C# デバッグに存在する属性を確認します
            // 既存の属性の説明にホバーを使用する
            // 詳細については、https://github.com/dotnet/vscode-csharp/blob/main/debugger-launchjson.md を参照してください
            "name": "英日翻訳",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            // ターゲット フレームワークを変更した場合は、プログラム パスを更新するようにしてください。
            "program": "${workspaceFolder}/BergamotTranslatorSharp.Tool/bin/Debug/net10.0/BergamotTranslatorSharp.Tool.dll",
            "args": [
                "en",
                "ja",
                "${input:text}"
            ],
            "cwd": "${workspaceFolder}/BergamotTranslatorSharp.Tool",
            // 'console' フィールドの詳細については、https://aka.ms/VSCode-CS-LaunchJson-Console を参照してください
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            // IntelliSense を使用して、C# デバッグに存在する属性を確認します
            // 既存の属性の説明にホバーを使用する
            // 詳細については、https://github.com/dotnet/vscode-csharp/blob/main/debugger-launchjson.md を参照してください
            "name": "韓日翻訳",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            // ターゲット フレームワークを変更した場合は、プログラム パスを更新するようにしてください。
            "program": "${workspaceFolder}/BergamotTranslatorSharp.Tool/bin/Debug/net10.0/BergamotTranslatorSharp.Tool.dll",
            "args": [
                "ko",
                "ja",
                "${input:text}"
            ],
            "cwd": "${workspaceFolder}/BergamotTranslatorSharp.Tool",
            // 'console' フィールドの詳細については、https://aka.ms/VSCode-CS-LaunchJson-Console を参照してください
            "console": "internalConsole",
            "stopAtEntry": false
        },
    ],
    "inputs": [
        {
            "id": "text",
            "type": "promptString",
            "description": "翻訳するテキスト",
            "default": "",
        }
    ]
}
